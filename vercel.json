{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,backend/tests/**,backend/.venv/**,backend/ferramentas/**,**/__pycache__/**,backend/picozero.db*,backend/.env,*.pdf}"
    }
  },
  "rewrites": [
    { "source": "/api/:caminho*", "destination": "/api/index" },
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/sim/:caminho*", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
