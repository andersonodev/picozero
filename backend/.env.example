# backend/.env.example — copie para .env (que NÃO vai para o git) e preencha.
# IA: chave de API do Vertex AI (Agent Platform). Sem chave, tudo responde por regras determinísticas.
# GEMINI_API_KEY/GOOGLE_API_KEY eram do AI Studio e não são mais lidas.
VERTEX_API_KEY=
# Cadeia de modelos, em ordem de preferência (troca de modelo em 404/429/503)
GEMINI_MODEL=gemini-3.8-flash,gemini-3.1-pro-preview,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_THINKING=low
GEMINI_MODEL_CHAT=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.6-flash
GEMINI_THINKING_CHAT=low
# Teto diário de chamadas ao Gemini (0 = sem teto; a chave do Vertex é paga)
PICOZERO_IA_LIMITE_DIARIO=0
PICOZERO_IA_POR_MINUTO=12
# Banco SQLite (padrão: backend/picozero.db local; /tmp na Vercel)
PICOZERO_DB=
# CORS (padrão "*")
PICOZERO_CORS=*
# Se definido, rotas de escrita exigem o header X-PicoZero-Token
PICOZERO_TOKEN=
# Webhook de saída para alertas altos/críticos (Slack, Google Chat, Teams)
ALERTA_WEBHOOK_URL=
# Relógio de demonstração (ex.: 2026-11-12T17:30); vazio = relógio real
PICOZERO_AGORA=
